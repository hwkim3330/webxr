{
  "name": "webxr-stream",
  "version": "1.0.0",
  "description": "Ultra low-latency WebRTC 1:N broadcasting platform with 360° video support",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "pm2:start": "pm2 start ecosystem.config.js",
